{
  "name": "wapri-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "公共前端包集合：Vue 3 组件库、Hooks、工具函数与 JSBridge，使用 pnpm workspace + changesets 管理",
  "keywords": [],
  "license": "MIT",
  "author": "wapri contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "wa changesetDoc tBuild",
    "changeset": "wa changesetDoc changeset",
    "clear": "wa clearLibrary",
    "dev": "wa changesetDoc dev",
    "doc": "dumi build",
    "enter-beta": "wa changesetDoc enterBeta",
    "exit-beta": "wa changesetDoc exitBeta",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preinstall": "npx only-allow pnpm",
    "pub": "wa checkBranch dev && pnpm build && wa changesetDoc pub",
    "pub:pure": "pnpm build && wa changesetDoc pub",
    "ver": "wa changesetDoc ver"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@wagq/wa-cli": "^0.6.66",
    "vue": "^3.4.0",
    "wa-postcss-pxtorem": "^0.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@dumijs/preset-vue": "^2.4.14",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@utoo/pack": "^1.5.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.4.0",
    "@wagq/lint-ox": "^0.1.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dumi": "2.4.49",
    "dumi-theme-antd-style": "^0.31.1",
    "father": "^4.4.0",
    "husky": "^8.x",
    "lint-staged": "^15.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "rimraf": "^6.1.3",
    "stylelint": "^16.3.1",
    "turbo": "^2.0.3",
    "typescript": "^5.4.5",
    "util": "^0.12.5",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "resolutions": {
    "stylelint": "^16.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mts,cts,vue}": [
      "oxlint --fix"
    ],
    "*.{js,jsx,ts,tsx,mts,cts,vue,json,jsonc,css,scss,less,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@9.4.0"
}
