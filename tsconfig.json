{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "./packages",
    "jsx": "preserve",
    "moduleResolution": "Node",
    "outDir": "dist",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".dumirc.ts", "demos", "packages/*/src/**/*", "packages/*/components/**/*"],
  // mcp 是 Node ESM 包，走自己的 tsconfig（NodeNext + types: node）；这里的 moduleResolution: Node
  // 解析不到 @modelcontextprotocol/sdk 的 exports 子路径，混在一起只会报假错。
  "exclude": ["packages/mcp"]
}
